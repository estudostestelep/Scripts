      "subject": "Reserva Confirmada",
      "body": "Ola {customer_name}! Sua reserva no {restaurant_name} esta confirmada para {reservation_date} as {reservation_time}. Mesa: {table_number} | Pessoas: {party_size}. Aguardamos voce!",
