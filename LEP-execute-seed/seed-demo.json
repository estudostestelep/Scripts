      "active": true
    },
    {
      "name": "Lembrete de Reserva",
      "channel": "whatsapp",
      "subject": "Lembrete",
      "body": "Ola {customer_name}! Sua reserva no {restaurant_name} e HOJE as {reservation_time}. Aguardamos voce! Mesa: {table_number}",
      "active": true
    },
    {
      "name": "Cancelamento de Reserva",
      "channel": "whatsapp",
      "subject": "Reserva Cancelada",
      "body": "Ola {customer_name}! Sua reserva no {restaurant_name} para {reservation_date} as {reservation_time} foi cancelada. Esperamos ve-lo em breve!",
      "active": true
    },
    {
      "name": "Mesa Disponivel",
      "channel": "whatsapp",
      "subject": "Mesa Disponivel",
      "body": "Ola {customer_name}! Uma mesa ficou disponivel no {restaurant_name}! Estimamos {estimated_wait} minutos de espera. Deseja confirmar?",
      "active": true
    },
    {
      "name": "Confirmacao por SMS",
      "channel": "sms",
      "subject": "Reserva Confirmada",
      "body": "{restaurant_name}: Reserva confirmada para {reservation_date} {reservation_time}. Mesa {table_number}.",
      "active": true
    },
    {
      "name": "Confirmacao por Email",
      "channel": "email",
      "subject": "Confirmacao de Reserva - {restaurant_name}",
      "body": "Prezado(a) {customer_name},\n\nSua reserva foi confirmada com sucesso!\n\nDetalhes:\n- Data: {reservation_date}\n- Horario: {reservation_time}\n- Mesa: {table_number}\n- Numero de pessoas: {party_size}\n\nEndereco: {restaurant_address}\n\nCaso precise alterar ou cancelar, entre em contato: {restaurant_phone}\n\nAguardamos voce!\n\nAtenciosamente,\nEquipe {restaurant_name}",
      "active": true
    }
  ],
