  "notification_templates": [
    {
      "name": "Confirmação de Reserva",
      "channel": "whatsapp",
      "subject": "Reserva Confirmada",
      "body": "Olá {customer_name}! Sua reserva no {restaurant_name} está confirmada para {reservation_date} às {reservation_time}. Mesa: {table_number} | Pessoas: {party_size}. Aguardamos você!",
      "active": true
    },
    {
      "name": "Pedido de Confirmação",
      "channel": "whatsapp",
      "subject": "Confirme sua Reserva",
      "body": "Olá {customer_name}! Lembramos que sua reserva no {restaurant_name} é amanhã, {reservation_date} às {reservation_time}. Responda SIM para confirmar ou NÃO para cancelar.",
      "active": true
    },
    {
      "name": "Lembrete de Reserva",
      "channel": "whatsapp",
      "subject": "Lembrete",
      "body": "Olá {customer_name}! Sua reserva no {restaurant_name} é HOJE às {reservation_time}. Aguardamos você! Mesa: {table_number}",
      "active": true
    },
    {
      "name": "Cancelamento de Reserva",
      "channel": "whatsapp",
      "subject": "Reserva Cancelada",
      "body": "Olá {customer_name}! Sua reserva no {restaurant_name} para {reservation_date} às {reservation_time} foi cancelada. Esperamos vê-lo em breve!",
      "active": true
    },
    {
      "name": "Mesa Disponível",
      "channel": "whatsapp",
      "subject": "Mesa Disponível",
      "body": "Olá {customer_name}! Uma mesa ficou disponível no {restaurant_name}! Estimamos {estimated_wait} minutos de espera. Deseja confirmar?",
      "active": true
    },
    {
      "name": "Confirmação por SMS",
      "channel": "sms",
      "subject": "Reserva Confirmada",
      "body": "{restaurant_name}: Reserva confirmada para {reservation_date} {reservation_time}. Mesa {table_number}.",
      "active": true
    },
    {
      "name": "Confirmação por Email",
      "channel": "email",
      "subject": "Confirmação de Reserva - {restaurant_name}",
      "body": "Prezado(a) {customer_name},\n\nSua reserva foi confirmada com sucesso!\n\nDetalhes:\n- Data: {reservation_date}\n- Horário: {reservation_time}\n- Mesa: {table_number}\n- Número de pessoas: {party_size}\n\nEndereço: {restaurant_address}\n\nCaso precise alterar ou cancelar, entre em contato: {restaurant_phone}\n\nAguardamos você!\n\nAtenciosamente,\nEquipe {restaurant_name}",
      "active": true
    }
  ],
